# Flask
SECRET_KEY=change-this-to-a-random-secret-key
SESSION_COOKIE_SECURE=False
FORCE_HTTPS=False
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Admin credentials
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=1234

# Hugging Face token (required for AI chatbot)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# SMTP (optional - for sending verification/reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Liver Care <noreply@livercare.com>
